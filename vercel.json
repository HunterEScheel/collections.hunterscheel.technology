{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/bio",
      "destination": "/bio.html"
    },
    {
      "source": "/hexmap",
      "destination": "/hexmap.html"
    },
    {
      "source": "/fireworks",
      "destination": "/fireworks.html"
    },
    {
      "source": "/fireworks/(.*)",
      "destination": "/fireworks.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
